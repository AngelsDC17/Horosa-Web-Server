# Horosa Web Server production defaults.
# Copy to .env on the server and adjust for the machine size.

HOROSA_DOMAIN=example.com

# Internal service ports. Keep these private behind Nginx.
HOROSA_SERVER_HOST=127.0.0.1
HOROSA_SERVER_PORT=9999
HOROSA_CHART_HOST=127.0.0.1
HOROSA_CHART_PORT=8899

# Frontend build-time API root. Use /api when Nginx proxies /api/ to the Java service.
HOROSA_PUBLIC_SERVER_ROOT=/api

# Small server defaults. For an 8GB server, 1024m-2048m is usually safe.
HOROSA_JAVA_XMS=256m
HOROSA_JAVA_XMX=1024m
HOROSA_JAVA_METASPACE=256m

# Python chart service concurrency. 4GB RAM: 4-8. 8GB RAM: 8-16.
HOROSA_CHART_THREAD_POOL=8

# Cache/database endpoints.
MONGODB_IP=127.0.0.1
REDIS_IP=127.0.0.1

# Disable heavy startup tasks unless the public site explicitly needs them.
HOROSA_ENABLE_STARTUP_CRON=0
HOROSA_ENABLE_STARTUP_TRANSGROUP_INIT=0
needtranslog=0
